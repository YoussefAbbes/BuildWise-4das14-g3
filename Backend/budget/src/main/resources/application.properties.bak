
# ==========================================
# BuildWise - Budget Service
# ==========================================

spring.application.name=budget
server.port=8086

# ==========================================
# Eureka - Service Discovery
# ==========================================

eureka.client.service-url.defaultZone=http://10.66.0.11:8761/eureka,http://10.66.0.2:8761/eureka
eureka.instance.prefer-ip-address=true
spring.cloud.inetutils.preferred-networks=10.66.0
eureka.instance.instance-id=${spring.application.name}:${server.port}

# Timeout Eureka
eureka.client.timeout.connect-timeout=3000
eureka.client.timeout.connect-request-timeout=3000
eureka.client.timeout.socket-timeout=8000

# Renouvellement du heartbeat
eureka.instance.lease-renewal-interval-in-seconds=5
eureka.instance.lease-expiration-duration-in-seconds=15

# ==========================================
# Actuator et Swagger
# ==========================================

management.endpoints.web.exposure.include=health,info

springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# ==========================================
# PostgreSQL + JPA
# ==========================================

spring.datasource.url=jdbc:postgresql://localhost:5432/budget_db
spring.datasource.username=postgres
spring.datasource.password=budget

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false

# ==========================================
# Cache Redis
# ==========================================

spring.data.redis.host=localhost
spring.data.redis.port=6379

spring.cache.type=redis
spring.cache.redis.time-to-live=10m

# Redis n'est pas encore démarré avant la phase cache
management.health.redis.enabled=false

# ==========================================
# Floci - Stockage S3 des factures
# ==========================================

buildwise.s3.endpoint=http://10.66.0.10:4566
buildwise.s3.bucket=bw-budget
buildwise.s3.region=us-east-1
buildwise.s3.path-style=true

# ==========================================
# Upload des factures
# ==========================================

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
